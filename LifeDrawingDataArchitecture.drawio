        <mxCell id="TgTqXhy73nRtWgJJtp_4-92" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="stitched_phashes" vertex="1">
          <mxGeometry height="30" width="60" x="910" y="40" as="geometry" />
