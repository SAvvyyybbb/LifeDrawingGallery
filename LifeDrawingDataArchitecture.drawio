        <mxCell id="TgTqXhy73nRtWgJJtp_4-64" edge="1" parent="1" style="shape=flexArrow;endArrow=classic;startArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=120;entryDy=50;entryPerimeter=0;" target="TgTqXhy73nRtWgJJtp_4-29" value="">
          <mxGeometry height="100" relative="1" width="100" as="geometry">
            <mxPoint x="280" y="960" as="sourcePoint" />
            <mxPoint x="530" y="870" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TgTqXhy73nRtWgJJtp_4-75" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=left;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/h1&gt;&lt;p style=&quot;&quot;&gt;Table is created on &quot;stitching&quot;.&lt;/p&gt;&lt;p style=&quot;&quot;&gt;Contains batch descriptions of staged images for later lookup.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="880" y="40" as="geometry" />
        </mxCell>
        <mxCell id="TgTqXhy73nRtWgJJtp_4-77" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;Table is created on &quot;stitching&quot;.&lt;/p&gt;&lt;p&gt;Contains data describing leftover and unstitched images from.&lt;/p&gt;&lt;p&gt;Containg previous file path, archived file path (either in stitched or leftover).&lt;/p&gt;&lt;p&gt;Records with export_type = leftover will be reintroduced into ingestion on prompt in Streamlit.&lt;/p&gt;" vertex="1">
          <mxGeometry height="220" width="180" x="690" y="40" as="geometry" />
        </mxCell>
        <mxCell id="TgTqXhy73nRtWgJJtp_4-78" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;Table is updated on &quot;ingestion scan&quot;.&lt;/p&gt;&lt;p&gt;Contains file path for current stitched batch outputs and Hash and Phash.&lt;br&gt;Stitch date and ID.&lt;/p&gt;&lt;p&gt;Note: Was planning on have these move to final destination in final review step but TBD.&lt;/p&gt;" vertex="1">
          <mxGeometry height="350" width="180" x="480" y="40" as="geometry" />
        </mxCell>
        <mxCell id="TgTqXhy73nRtWgJJtp_4-83" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;Data is created by scraper upon collection from Discord.&lt;/p&gt;&lt;p&gt;Contains images initial hash and phash for recognition.&lt;/p&gt;&lt;p&gt;Also contains a modified hash if manual edits have been made by gallery admin.&lt;/p&gt;&lt;p&gt;This is the front end query table where is_stitched and in_processing can be identified using SQL query.&lt;/p&gt;" vertex="1">
          <mxGeometry height="270" width="130" x="-140" y="40" as="geometry" />
        </mxCell>
        <mxCell id="TgTqXhy73nRtWgJJtp_4-84" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;Table is updated on &quot;pre processing&quot; step.&lt;/p&gt;&lt;p&gt;It contains a lookup between original Discord image hash, and post edit hash.&lt;br&gt;&lt;br&gt;Original_hash = discord&lt;br&gt;hash = new cleaned image hash&lt;/p&gt;&lt;p&gt;This also contains the categorization for the image by aspect ratio, and timestamp.&lt;/p&gt;" vertex="1">
          <mxGeometry height="270" width="190" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="TgTqXhy73nRtWgJJtp_4-85" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;Table is updated on &quot;ingestion scan&quot;. &lt;br&gt;&lt;br&gt;Images that have been cleaned of borders are assigned a batch_id and sorted by colour weighting.&lt;br&gt;&lt;br&gt;Join to previous table with processed_image_data.hash = images.hash.&lt;br&gt;&lt;br&gt;Also contains perceptual_hash for deduplication in stitching steps.&lt;/p&gt;&lt;p&gt;This table assigns order_ids for each image in each batch_id.&lt;/p&gt;" vertex="1">
          <mxGeometry height="340" width="190" x="280" y="40" as="geometry" />
        </mxCell>
        <mxCell id="TgTqXhy73nRtWgJJtp_4-86" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="raw_image_data" vertex="1">
          <mxGeometry height="30" width="60" x="-120" y="40" as="geometry" />
        </mxCell>
        <mxCell id="TgTqXhy73nRtWgJJtp_4-87" edge="1" parent="1" source="TgTqXhy73nRtWgJJtp_4-66" style="endArrow=none;html=1;rounded=0;exitX=0;exitY=0.087;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.092;entryDx=0;entryDy=0;entryPerimeter=0;" target="TgTqXhy73nRtWgJJtp_4-66" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="440" y="390" as="sourcePoint" />
            <mxPoint x="490" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TgTqXhy73nRtWgJJtp_4-88" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="processed_image_data" vertex="1">
          <mxGeometry height="30" width="60" x="60" y="40" as="geometry" />
        </mxCell>
